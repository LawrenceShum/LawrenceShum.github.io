---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import publications from '../content/publications/publications.json';

const projects = Object.values(import.meta.glob('../content/projects/*.md', { eager: true }))
  .filter((project) => project.frontmatter.featured && !project.frontmatter.draft)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
  )
  .slice(0, 4);

const selectedPublications = publications
  .filter((publication) => publication.selected)
  .sort((a, b) => b.year - a.year)
  .slice(0, 4);

const interests = [
  'Physically based simulation',
  'Shell mechanics and shellular structures',
  'Homogenization and computational mechanics',
  'Differentiable simulation and inverse design',
  'Generative AI for physical design',
  'LLM-based computational design agents',
];
---

<BaseLayout
  title="Ruihong Cen"
  description="PhD researcher in computer graphics, physical simulation, and computational design."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Computer graphics · Simulation · Computational design</p>
        <h1>Ruihong Cen</h1>
        <p class="lead">
          PhD researcher in computer graphics, physical simulation, and computational
          design.
        </p>
        <p class="hero-summary">
          I work on physically based simulation, shell and solid mechanics,
          differentiable simulation, and generative AI methods for computational design.
        </p>
        <div class="link-row" aria-label="Contact and profile links">
          <a class="pill-link" href="mailto:ruihong.cen@example.com">Email</a>
          <a class="pill-link" href="https://github.com/LawrenceShum">GitHub</a>
          <a class="pill-link" href="#">Google Scholar</a>
          <a class="pill-link" href="/cv.pdf">CV</a>
        </div>
      </div>
      <figure class="portrait-card">
        <div class="portrait-placeholder" aria-label="Portrait placeholder">RC</div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Research Interests</h2>
      </div>
      <ul class="interest-grid">
        {interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Selected Publications</h2>
        <a class="text-link" href="/publications/">All publications</a>
      </div>
      <div class="list-stack">
        {
          selectedPublications.map((publication) => (
            <PublicationItem publication={publication} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Featured Projects</h2>
        <a class="text-link" href="/projects/">All projects</a>
      </div>
      <div class="project-grid">
        {
          projects.map((project) => (
            <ProjectCard
              project={project}
              slug={project.file.split('/').pop()?.replace(/\.md$/, '')}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
