---
import PageLayout from '../layouts/PageLayout.astro';

const interests = [
  'Computer graphics',
  'Generative AI for shape design',
  'LLM-based design agents'
];
---

<PageLayout title="About" intro="Biography, research interests, and contact details." narrow>
  <section class="section article-container prose">
    <h2>Biography</h2>
    <p>
      I am a PhD researcher working at the intersection of computer graphics
      and generative AI. My research interests include
      physically based simulation, computational design, 
      and AI-assisted computational design.
    </p>

    <h2>Research Interests</h2>
    <ul>
      {interests.map((interest) => <li>{interest}</li>)}
    </ul>

    <h2>Education</h2>
    <p>PhD. National University of Singapore, 2025 - 2029 (expected).</p>
    <p>M.E. Nankai University, 2021 - 2024.</p>
    <p>B.E. South China University of Technology, 2017 - 2021.</p>  

    <h2>Experience</h2>
    <p>Add research lab, internship, teaching, and collaboration details here.</p>

    <h2>Contact</h2>
    <p>
      <a href="mailto:ruihongcen11@gmail.com">Email</a> ·
      <a href="https://github.com/LawrenceShum">GitHub</a> ·
    </p>
  </section>
</PageLayout>
