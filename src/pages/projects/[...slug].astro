---
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const projects = Object.values(import.meta.glob('../../content/projects/*.md', { eager: true })).filter(
    (project) => !project.frontmatter.draft,
  );

  return projects.map((project) => ({
    params: {
      slug: project.file.split('/').pop()?.replace(/\.md$/, ''),
    },
    props: { project },
  }));
}

const { project } = Astro.props;
const Content = project.default;
const links = Object.entries(project.frontmatter.links ?? {}).filter(([, href]) => href);
---

<PageLayout
  title={project.frontmatter.title}
  intro={project.frontmatter.description}
  narrow
>
  <section class="section article-container">
    <p class="meta">
      {project.frontmatter.status} · {new Date(project.frontmatter.date).getFullYear()}
    </p>
    {project.frontmatter.tags?.length > 0 && (
      <div class="tag-row">
        {project.frontmatter.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    )}
    {links.length > 0 && (
      <div class="item-links">
        {links.map(([label, href]) => <a href={href as string}>{label}</a>)}
      </div>
    )}
  </section>
  <section class="article-container prose">
    <Content />
  </section>
</PageLayout>
